<!--SOFTENGINE-VAR!JWHtmlStart-->
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<title>&#xDC;bersicht &#x2014; Empfang &amp; S&#xF6;hne</title>
<script src="<!--SOFTENGINE-VAR!EditorPfad-->/JS/JS/basis.html.interface.js"></script>
<style>
:root {

  --se-bg:        #eceff1;
  --se-panel:     #ffffff;
  --se-panel-2:   #f2f4f6;

  --se-ink:       #101c26;
  --se-muted:     #51606d;
  --se-faint:     #8494a1;

  --se-line:      #c9d2d9;
  --se-line-soft: #e0e6ea;

  --se-scrim:     rgba(16, 28, 38, 0.45);

  --se-accent:      #0e7a58;
  --se-accent-dark: #0b6247;
  --se-accent-soft: #e4f2ec;

  --se-red:         #c0201a;
  --se-red-soft:    #fbe7e6;
  --se-amber:       #9a6a00;
  --se-amber-soft:  #f8f0dc;
  --se-blue:        #20527e;
  --se-blue-soft:   #e6eef5;
  --se-violet:      #5b5e8f;
  --se-violet-soft: #eaebf5;
  --se-green:       #47761d;
  --se-green-soft:  #ecf3e1;

  --se-red-shell:   #fdf5f4;  --se-red-line:   #eecfcd;
  --se-amber-shell: #fcf9ef;  --se-amber-line: #e9dcbd;
  --se-blue-shell:  #f6f9fc;  --se-blue-line:  #cfdde9;
  --se-green-shell: #f7faf0;  --se-green-line: #d9e4c4;

  --se-card-bg:     #ffffff;
  --se-card-line:   #c9d2d9;

  --se-r-sm:   2px;
  --se-r-md:   3px;
  --se-r-lg:   4px;
  --se-r-pill: 999px;

  --se-font: "Segoe UI", system-ui, -apple-system, sans-serif;
  --se-mono: "IBM Plex Mono", Consolas, monospace;
  --se-fs:    13.5px;
  --se-fs-sm: 12px;
  --se-fs-xs: 10.5px;
  --se-fs-lg: 15px;

  --se-gap-sm: 6px;
  --se-gap:    10px;
  --se-gap-lg: 16px;

  --se-shadow-ruhe:  0 1px 2px rgba(16, 28, 38, 0.10);
  --se-shadow-hover: 0 3px 8px rgba(16, 28, 38, 0.16);
  --se-shadow-popup: 0 10px 28px rgba(16, 28, 38, 0.24);

  --se-move: 130ms ease-out;
}

@media (prefers-reduced-motion: reduce) {
  :root {
    --se-move: 0ms;
  }
}

/* Grundgeruest + Wurzel-Raster (identisch zum Editor-Canvas, rasterFlaecheStyle) */
html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; }
body { background: var(--se-bg); font-family: var(--se-font); font-size: var(--se-fs); color: var(--se-ink); }
.ff-root { box-sizing: border-box; width: 100%; height: 100%; overflow: auto; display:grid;grid-template-columns:repeat(24, 1fr);grid-auto-rows:12px;gap:8px;align-content:start; padding: 16px; }
</style>
</head>
<body>
  <div class="ff-root">
    <ff-zeile fuellt style="grid-column:1 / span 24;grid-row:1 / span 3;min-width:0;min-height:0">
      <ff-datum></ff-datum>
      <ff-button label="Nachfa&#xDF; &#xF6;ffnen &#x2014; &#xE4;tsch" data-ff-aktionen="{&quot;onClick&quot;:[{&quot;type&quot;:&quot;POPUP_OPEN&quot;,&quot;resultKey&quot;:&quot;&quot;,&quot;popup&quot;:&quot;Neue Behandlung f&#xFC;r Bello&quot;},{&quot;type&quot;:&quot;START_TOOL&quot;,&quot;resultKey&quot;:&quot;&quot;,&quot;toolNr&quot;:&quot;42&quot;,&quot;toolParams&quot;:[&quot;{PINDEX}&quot;,&quot;fest &#xE4;&quot;]}]}"></ff-button>
    </ff-zeile>
    <ff-kanban source="q-termine" statusfield="20_10" data-ff-aktionen="{&quot;onCardDrop&quot;:[{&quot;type&quot;:&quot;RELATION&quot;,&quot;resultKey&quot;:&quot;&quot;,&quot;relationId&quot;:&quot;rel-put&quot;,&quot;params&quot;:[{&quot;source&quot;:&quot;context&quot;,&quot;value&quot;:&quot;PINDEX&quot;},{&quot;source&quot;:&quot;fixed&quot;,&quot;value&quot;:&quot;&quot;},{&quot;source&quot;:&quot;data_field&quot;,&quot;value&quot;:&quot;30_10&quot;,&quot;dataSourceId&quot;:&quot;q-termine&quot;}],&quot;extraParams&quot;:[{&quot;source&quot;:&quot;context&quot;,&quot;value&quot;:&quot;VALUE&quot;}]}]}" data-ff-id="board" fuellt style="grid-column:1 / span 24;grid-row:4 / span 20;min-width:0;min-height:0">
      <ff-kanban-spalte heading="Offen" style="flex-grow:1;flex-basis:0;min-width:0">
        <template data-ff-template>
          <ff-card heading="R&#xFC;ckruf" text="Zeile mit &#xDC;mlaut" chiptext="Pr&#xFC;fen" headingfield="40_20" timefield="10_5" avatarfield="30_10" style="align-self:stretch"></ff-card>
        </template>
      </ff-kanban-spalte>
      <ff-kanban-spalte heading="Erledigt" style="flex-grow:1;flex-basis:0;min-width:0"></ff-kanban-spalte>
      <ff-kanban-spalte heading="Auffang" auffang="ja" style="flex-grow:1;flex-basis:0;min-width:0"></ff-kanban-spalte>
    </ff-kanban>
    <ff-formfeld source="q-adressen" valuefield="10_30" data-ff-aktionen="{&quot;onChange&quot;:[{&quot;type&quot;:&quot;RELATION&quot;,&quot;resultKey&quot;:&quot;&quot;,&quot;relationId&quot;:&quot;rel-put&quot;,&quot;params&quot;:[{&quot;source&quot;:&quot;context&quot;,&quot;value&quot;:&quot;PINDEX&quot;},{&quot;source&quot;:&quot;fixed&quot;,&quot;value&quot;:&quot;0042&quot;},{&quot;source&quot;:&quot;context&quot;,&quot;value&quot;:&quot;VALUE&quot;}],&quot;extraParams&quot;:[]}]}" data-ff-block-id="feld" fuellt style="grid-column:7 / span 12;grid-row:24 / span 3;min-width:0;min-height:0"></ff-formfeld>
    <ff-tabelle source="q-termine" spalten="[{&quot;titel&quot;:&quot;Wer&quot;,&quot;feld&quot;:&quot;40_20&quot;},{&quot;titel&quot;:&quot;Wann&quot;,&quot;feld&quot;:&quot;10_5&quot;},{&quot;titel&quot;:&quot;Tier &#x2014; &#xC4;rztin&quot;,&quot;feld&quot;:&quot;30_10&quot;}]" suche="nein" tagfield="50_10" data-ff-id="tab" fuellt style="grid-column:1 / span 24;grid-row:27 / span 8;min-width:0;min-height:0"></ff-tabelle>
    <ff-trenner fuellt style="grid-column:1 / span 24;grid-row:35 / span 1;min-width:0;min-height:0"></ff-trenner>
    <ff-text text="&#xDC;bersicht &#x2014; Sprechstunde &#xE0; la carte" fuellt style="grid-column:1 / span 12;grid-row:36 / span 2;min-width:0;min-height:0"></ff-text>
    <ff-popup name="Neue Behandlung f&#xFC;r Bello" breite="480" hoehe="320">
      <ff-zeile>
        <ff-datum></ff-datum>
      </ff-zeile>
    </ff-popup>
  </div>
<script>
window.FF_DATA_SOURCES = [{"id":"q-termine","name":"Terminplaner","tableId":"IDBID0004","indexField":"0_10"},{"id":"q-adressen","name":"Adre\u00DFstamm","tableId":"ADR","indexField":""}];
window.FF_RELATIONS = [{"id":"rel-put","verb":"PUT_RELATION","nr":"0174","params":["{PINDEX}","","{VALUE}"],"allowExtraParams":true}];
/* Runtime-Buendel herausgeschnitten - bewacht von check:runtime + export.test.ts */
</script>
</body>
</html>
<!--SOFTENGINE-VAR!JWHtmlEnde-->