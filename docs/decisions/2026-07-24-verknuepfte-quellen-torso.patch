+// ---------- Verknuepfte Quellen -> FF_SOURCE_LINKS (verknuepfte Quellen) ----------
+
+// Zusatzquellen (aus qualifizierten Bindungen "sourceId::code") + die dazu
+// benutzten Verknuepfungen einsammeln. Deterministisch (Baum-Reihenfolge,
+// dedupliziert). `primaer` = die schon gesammelten Primaerquellen, damit eine
+// Zusatzquelle nicht doppelt in die SEFILELOOP geraet. Die "Primaerquelle" je
+// Bindung ist die naechste acceptsDataSource-Vorfahrin (Board fuer Karten,
+// Feld fuer sich selbst) — sie wird beim Abstieg mitgereicht.
+function collectVerbund(
+  tree: BlockTree,
+  sources: readonly DataSource[],
+  links: readonly SourceLink[],
+  primaer: readonly DataSource[],
+): { extraSources: DataSource[]; usedLinks: SourceLink[] } {
+  const schon = new Set(primaer.map((s) => s.id))
+  const extraSources: DataSource[] = []
+  const seenLink = new Set<string>()
+  const usedLinks: SourceLink[] = []
+  const addSource = (id: string): void => {
+    if (schon.has(id)) return
+    const src = sources.find((s) => s.id === id)
+    if (src) { schon.add(id); extraSources.push(src) }
+  }
+  const addLink = (a: string, b: string): void => {
+    const link = findLink(links, a, b)
+    if (link && !seenLink.has(link.id)) { seenLink.add(link.id); usedLinks.push(link) }
+  }
+  const visit = (node: BlockNode | undefined, primaerId: string): void => {
+    if (!node) return
+    const def = getBlockDefinition(node.type)
+    let aktuell = primaerId
+    if (def?.acceptsDataSource) {
+      const s = typeof node.props.source === 'string' ? node.props.source : ''
+      if (s !== '') aktuell = s
+    }
+    for (const spot of def?.bindableSpots ?? []) {
+      const raw = node.props[bindingProp(spot.prop)]
+      if (typeof raw !== 'string' || raw === '') continue
+      const { sourceId } = splitBindung(raw)
+      if (sourceId && sourceId !== aktuell) {
+        addSource(sourceId)
+        if (aktuell !== '') addLink(aktuell, sourceId)
+      }
+    }
+    node.childIds.forEach((id) => visit(tree[id], aktuell))
+  }
+  visit(tree[ROOT_ID], '')
+  return { extraSources, usedLinks }
+}
