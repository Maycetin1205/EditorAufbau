+
+// ---------- Verknuepfte Quellen (maskenweiter Verbund) ----------
+//
+// Eine Verknuepfung koppelt zwei Quellen ueber 1-3 Schluesselpaare (Feldcodes,
+// UND-verknuepft). Die benutzten Verknuepfungen reisen als
+// window.FF_SOURCE_LINKS mit der Maske; hier wird ausschliesslich darueber
+// aufgeloest. Wie der Rest der Schicht: kein DOM, kein Baustein.
+
+// Laufzeit-Form einer Verknuepfung (analog RuntimeDataSource): nur die
+// Technikwerte, die der Verbund braucht.
+export interface RuntimeSourceLink {
+  fromId: string
+  toId: string
+  keys: { from: string; to: string }[]
+}
+
+// Verknuepfung zwischen zwei Quellen-ids aus einer FF_SOURCE_LINKS-Liste
+// (pur, testbar). Richtungsunabhaengig: passt fuer {a,b} UND {b,a}. Kaputte/
+// unvollstaendige Eintraege werden ignoriert (nie raten).
+export function findRuntimeLink(list: unknown, aId: string, bId: string): RuntimeSourceLink | undefined {
+  if (!Array.isArray(list) || aId === '' || bId === '') return undefined
+  for (const entry of list) {
+    if (!isRecord(entry)) continue
+    if (typeof entry.fromId !== 'string' || typeof entry.toId !== 'string') continue
+    const passt = (entry.fromId === aId && entry.toId === bId)
+      || (entry.fromId === bId && entry.toId === aId)
+    if (!passt || !Array.isArray(entry.keys)) continue
+    const keys: { from: string; to: string }[] = []
+    for (const k of entry.keys) {
+      if (isRecord(k) && typeof k.from === 'string' && typeof k.to === 'string') {
+        keys.push({ from: k.from, to: k.to })
+      }
+    }
+    if (keys.length === 0) continue
+    return { fromId: entry.fromId, toId: entry.toId, keys }
+  }
+  return undefined
+}
+
+// Bindungswert zerlegen: "sourceId::code" -> {sourceId, code}; "code" -> {code}.
+// DIE eine Stelle, die den qualifizierten Bindungsstring liest (Editor UND
+// Laufzeit). Kein '::' -> Feld der Haupt-Quelle des Bausteins (abwaertskompat).
+export interface ParsedBinding {
+  sourceId?: string
+  code: string
+}
+export function splitBindung(value: string): ParsedBinding {
+  const at = value.indexOf('::')
+  if (at < 0) return { code: value }
+  return { sourceId: value.slice(0, at), code: value.slice(at + 2) }
+}
+
+// Bindungswert bauen (Gegenstueck zu splitBindung): Feld der Haupt-Quelle ->
+// nur der Code; Feld einer Zusatz-Quelle -> "sourceId::code". Leerer Code =
+// ungebunden.
+export function baueBindung(sourceId: string, code: string, hauptSourceId: string): string {
+  if (code === '') return ''
+  return sourceId === '' || sourceId === hauptSourceId ? code : `${sourceId}::${code}`
+}
+
+// Erste Zusatzzeile, deren ALLE Schluesselpaare gleich sind (getrimmt, Gross/
+// klein egal, wie columnIndexFor). Leere Schluesselwerte treffen nie -> kein
+// versehentliches Zusammenfallen. Das generische petMasterOf der Referenzmaske.
+export function verbinde(
+  hauptzeile: unknown,
+  zusatzzeilen: readonly unknown[],
+  schluesselpaare: readonly { haupt: string; zusatz: string }[],
+): unknown | undefined {
+  if (schluesselpaare.length === 0) return undefined
+  const hauptWerte = schluesselpaare.map((p) => getField(hauptzeile, p.haupt).trim().toLowerCase())
+  if (hauptWerte.some((w) => w === '')) return undefined
+  for (const zeile of zusatzzeilen) {
+    let alle = true
+    for (let i = 0; i < schluesselpaare.length; i++) {
+      const zw = getField(zeile, schluesselpaare[i].zusatz).trim().toLowerCase()
+      if (zw === '' || zw !== hauptWerte[i]) { alle = false; break }
+    }
+    if (alle) return zeile
+  }
+  return undefined
+}
+
+// Wert einer gebundenen Stelle aufloesen -- Haupt-Quelle direkt, sonst ueber
+// eine Verknuepfung aus der passenden Zusatz-Zeile. DER geteilte Resolver, den
+// beide Hydrierungen (Kanban-Karte, Formularfeld) rufen -- damit erbt jeder
+// bindbare Baustein den Mehrquellen-Zugriff ohne Sondercode (Regel 2). Kein
+// Treffer / kein Link / keine Zusatzzeile -> '' (nie raten; Preflight warnt
+// bereits im Editor).
+export function aufloeseWert(args: {
+  hauptzeile: unknown
+  hauptSourceId: string
+  bindung: string
+  dataSources: unknown
+  links: unknown
+  seData: unknown
+}): string {
+  const { sourceId, code } = splitBindung(args.bindung)
+  if (code === '') return ''
+  if (!sourceId || sourceId === args.hauptSourceId) {
+    return getField(args.hauptzeile, code)
+  }
+  const link = findRuntimeLink(args.links, args.hauptSourceId, sourceId)
+  if (!link) return ''
+  // Schluesselpaare in {haupt,zusatz}-Form ausrichten (Link ist richtungsfrei).
+  const schluesselpaare = link.keys.map((k) =>
+    link.fromId === args.hauptSourceId
+      ? { haupt: k.from, zusatz: k.to }
+      : { haupt: k.to, zusatz: k.from },
+  )
+  const zusatz = findRuntimeDataSource(args.dataSources, sourceId)
+  if (!zusatz) return ''
+  const zeilen = rowsFor(args.seData, zusatz.name, zusatz.tableId)
+  const partner = verbinde(args.hauptzeile, zeilen, schluesselpaare)
+  return partner ? getField(partner, code) : ''
+}
